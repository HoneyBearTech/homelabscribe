{
  // The license-selling Worker. Deploy it by hand from this folder: `npx wrangler@4 deploy`.
  // It is separate from the website Worker in the repo root.
  "name": "homelabscribe-license",
  "main": "src/index.js",
  "compatibility_date": "2026-10-17",
  "routes": [{ "pattern": "license.homelabscribe.com", "custom_domain": true }],
  // Remembers which orders were already emailed, so a retried webhook never sends a second key.
  // Create it with `npx wrangler@4 kv namespace create ORDERS`, then paste the id below.
  "kv_namespaces": [{ "binding": "ORDERS", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "vars": {
    "PRODUCT_ID": "REPLACE_WITH_LEMON_SQUEEZY_PRODUCT_ID",
    "FROM_ADDRESS": "HomelabScribe <licenses@homelabscribe.com>",
    "REPLY_TO": "support@homelabscribe.com"
  }
  // Secrets (set with `npx wrangler@4 secret put NAME`, never in this file):
  //   LICENSE_SIGNING_KEY, LEMONSQUEEZY_WEBHOOK_SECRET, RESEND_API_KEY
}
